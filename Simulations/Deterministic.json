{
    "voltage-transformation": {"scale": 1, "translate": 0 },
    "time-bins": 20000,
    "sample-rate": 1000000000,
    "digitiser-config": {
        "auto-digitisers": {
            "num-digitisers": { "int-env" : "NUM_DIGITISERS" },
            "num-channels-per-digitiser": { "int" : 8 }
        }
    },
    "pulses": [
                {
                    "pulse-type": "flat",
                    "start":  { "random-type": "constant", "value": { "float-func": { "scale": 1, "translate": 300 } } },
                    "width":  { "random-type": "constant", "value": { "float-func": { "scale": 10, "translate": 20 } } },
                    "height": { "random-type": "constant", "value": { "float-func": { "scale": 500, "translate": 2000 } } }
                }],
    "event-lists": [
        {
            "pulses": [ {"weight": 1, "pulse-index": 0} ],
            "noises": [],
            "num-pulses": { "random-type": "constant", "value": { "int": 1 }}
        }
    ],
    "schedule" : [
        { "generate-trace": { "event-list-index": 0, "repeat": 1}},
        { "set-timestamp": "now"},
        { "ensure-delay-ms": 0 },
        { "send-run-start" : { "name": { "text-env": "RUN_NAME" }, "instrument": { "text": "MuSR" }}},
        { "wait-ms": 200 },
        { "set-timestamp": { "advance-by-ms": 200}},
        { "frame-loop" : {
                "start": { "int": 0 },
                "end": { "int": 4 },
                "schedule" : [
                    { "set-timestamp": { "advance-by-ms": 20}},
                    {
                        "digitiser-loop" : {
                            "start": { "int": 0 },
                            "end": { "int-env" : "MAX_DIGITISER" },
                            "schedule" : [
                                { "send-digitiser-trace": "replace-random" }
                            ]
                        }
                    }
                ]
            }
        },
        { "wait-ms": 2000 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-run-stop": { "name": { "text-env": "RUN_NAME" } } }
    ]
}