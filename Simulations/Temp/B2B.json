{
    "voltage-transformation": {"scale": 1, "translate": 0 },
    "time-bins": { "from-env-var": "TIME_BINS" },
    "sample-rate": { "const": 1000000000 },
    "digitiser-config": {
        "auto-digitisers": {
            "num-digitisers": { "from-env-var" : "NUM_DIGITISERS" },
            "num-channels-per-digitiser": { "const" : 1 }
        }
    },
    "pulses": [
        {
            "pulse-type": "back-to-back-exp",
            "spread":      { "random-type": "constant-float", "value": { "const": 5.5 } },
            "rise":        { "random-type": "constant-float", "value": { "const": 3.5 } },
            "decay":       { "random-type": "constant-float", "value": { "const": 5.4 } },
            "peak_time":   { "random-type": "uniform-float", "min": { "const": 0 }, "max": { "from-env-var": "TIME_BINS" } },
            "peak_height": { "random-type": "uniform-float", "min": { "const": 1000 }, "max": { "const": 1100 } }
        }
    ],
    "event-lists": [
        {
            "pulses": [ {"weight": 1, "pulse-index": 1} ],
            "noises": [],
            "num-pulses": { "random-type": "uniform-int", "min": { "const": 3 }, "max": { "const": 5 }}
        },
        {
            "pulses": [ {"weight": 1, "pulse-index": 0} ],
            "noises": [],
            "num-pulses": { "random-type": "uniform-int", "min": { "const": 1 }, "max": { "const": 25 }}
        }
    ],
    "schedule" : [
        { "generate-trace": { "event-list-index": 1, "repeat": 128}},
        { "set-timestamp": "now"},
        { "ensure-delay-ms": 0 },
        { "send-run-start" : { "name": { "text-env": "RUN_NAME" }, "filename": { "text-env": "RUN_NAME" }, "instrument": { "text": "Simulator" }}},
        { "wait-ms": 1000 },
        { "set-timestamp": { "advance-by-ms": 20 } },
        { "frame-loop" : {
                "start": { "const": 0 },
                "end": { "from-env-var": "LAST_FRAME" },
                "schedule" : [
                    { "set-timestamp": { "advance-by-ms": 20}},
                    {
                        "digitiser-loop" : {
                            "start": { "const": 0 },
                            "end": { "from-env-var" : "LAST_DIGITISER" },
                            "schedule" : [
                                { "send-digitiser-trace": "replace-random" },
                                { "wait-ms": 1 }
                            ]
                        }
                    }
                ]
            }
        },
        { "wait-ms": 500 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-run-stop": { "name": { "text-env": "RUN_NAME" } } }
    ]
}