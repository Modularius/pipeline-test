{
    "voltage-transformation": {"scale": 1, "translate": 0 },
    "time-bins": 20000,
    "sample-rate": 1000000000,
    "digitiser-config": {
        "auto-aggregated-frame": {
            "num-channels": { "int" : 64 }
        }
    },
    "pulses": [
                {
                    "pulse-type": "flat",
                    "start":  { "random-type": "exponential", "lifetime": { "float": 2200 } },
                    "width":  { "random-type": "uniform", "min": { "float": 20 }, "max": { "float": 50 } },
                    "height": { "random-type": "uniform", "min": { "float": 2000 }, "max": { "float": 4000 } }
                },
                {
                    "pulse-type": "triangular",
                    "start":     { "random-type": "exponential", "lifetime": { "float": 2200 } },
                    "width":     { "random-type": "uniform", "min": { "float": 20 }, "max": { "float": 50 } },
                    "peak_time": { "random-type": "uniform", "min": { "float": 0.25 }, "max": { "float": 0.75 } },
                    "height":    { "random-type": "uniform", "min": { "float": 2000 }, "max": { "float": 4000 } }
                }],
    "event-lists": [
        {
            "pulses": [ {"weight": 1, "pulse-index": 0} ],
            "noises": [],
            "num-pulses": { "random-type": "constant", "value": { "int": 5 }}
        },
        {
            "pulses": [ {"weight": 1, "pulse-index": 1} ],
            "noises": [],
            "num-pulses": { "random-type": "constant", "value": { "int": 5 }}
        }
    ],
    "schedule" : [
        { "generate-event-list": { "event-list-index": 1, "repeat": 512}},
        { "set-timestamp": {"to": "2025-03-14T10:20:00.0Z"}},
        { "ensure-delay-ms": 0 },
        { "send-run-start" : { "name": { "text": "SELOG_TESTRUN" }, "instrument": { "text": "Simulator" }}},
        { "wait-ms": 1000 },
        { "set-timestamp": { "advance-by-ms": 20 } },
        { "frame-loop" : {
                "start": { "int": 0 },
                "end": { "int": 280 },
                "schedule" : [
                    { "set-timestamp": { "advance-by-ms": 20}},
                    { "send-aggregated-frame-event-list" : {
                        "source-options": { "source": "select-from-cache", "replace-random": {} },
                        "channel-indices" : { "min": 0, "max": 63 }
                    } }
                ]
            }
        },
        { "send-sample-env-log" : {
            "name" : { "text" : "Temperature" },
            "values-type" : "float64",
            "location": "unknown",
            "timestamps": ["2025-03-14T10:20:00.0Z", "2025-03-14T10:20:01.0Z", "2025-03-14T10:20:02.0Z", "2025-03-14T10:20:03.0Z", "2025-03-14T10:20:04.0Z"],
            "values" : ["39", "36", "36", "37", "35"]
        } },
        { "wait-ms": 500 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-run-stop": { "name": { "text": "SELOG_TESTRUN" } } }
    ]
}