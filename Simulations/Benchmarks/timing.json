{
    "voltage-transformation": {"scale": 1, "translate": 0 },
    "time-bins": 50000,
    "sample-rate": 1000000000,
    "digitiser-config": {
        "auto-digitisers": {
            "num-digitisers": { "int" : 8 },
            "num-channels-per-digitiser": { "int" : 8 }
        }
    },
    "pulses": [
                {
                    "pulse-type": "triangular",
                    "start":     { "random-type": "uniform", "min": { "float": 1 }, "max": { "float": 50000 } },
                    "width":     { "random-type": "uniform", "min": { "float": 3 }, "max": { "float": 5 } },
                    "peak_time": { "random-type": "uniform", "min": { "float": 0.25 }, "max": { "float": 0.75 } },
                    "height":    { "random-type": "uniform", "min": { "float": 2000 }, "max": { "float": 4000 } }
                }],
    "event-lists": [
        {
            "pulses": [ {"weight": 1, "pulse-index": 0} ],
            "noises": [],
            "num-pulses": { "random-type": "uniform", "min": { "int": 1 }, "max": { "int": 500 }}
        }
    ],
    "schedule" : [
        { "set-timestamp": "now"},
        { "ensure-delay-ms": 0 },
        { "send-run-start" : { "name": { "text-env": "RUN_NAME" }, "filename": { "text-env": "RUN_NAME" }, "instrument": { "text": "Simulator" }}},
        { "wait-ms": 100 },
        { "set-timestamp": { "advance-by-ms": 200}},
        { "frame-loop" : {
                "start": { "int": 0 },
                "end": { "int": 100 },
                "schedule" : [
                    { "set-timestamp": { "advance-by-ms": 20}},
                    {
                        "digitiser-loop" : {
                            "start": { "int": 0 },
                            "end": { "int" : 7 },
                            "schedule" : [
                                { "generate-trace": { "event-list-index": 0, "repeat": 8}},
                                { "send-digitiser-trace": "pop-front" },
                                { "wait-ms": 1 }
                            ]
                        }
                    }
                ]
            }
        },
        { "wait-ms": 100 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-run-stop": { "name": { "text-env": "RUN_NAME" } } },
        { "wait-ms": 100 }
    ]
}