{
    "voltage-transformation": {"scale": 1, "translate": 0 },
    "time-bins": {"const": 20000 },
    "sample-rate": {"const": 1000000000 },
    "digitiser-config": {
        "auto-aggregated-frame": {
            "num-channels": { "const": 64 }
        }
    },
    "pulses": [
        {
            "pulse-type": "flat",
            "start":  { "random-type": "exponential", "lifetime": { "const": 2200 } },
            "width":  { "random-type": "uniform-float", "min": { "const": 20 }, "max": { "const": 50 } },
            "height": { "random-type": "uniform-float", "min": { "const": 2000 }, "max": { "const": 4000 } }
        }],
    "event-lists": [
        {
            "pulses": [ {"weight": 1, "pulse-index": 0} ],
            "noises": [],
            "num-pulses": { "random-type": "constant-int", "value": { "const": 45 }}
        }
    ],
    "schedule" : [
        { "set-timestamp": "now"},
        { "ensure-delay-ms": 0 },
        { "send-run-start" : { "name": { "text": "MUSR00000035" }, "filename": { "text": "MUSR00000035" }, "instrument": { "text": "MUSR" }}},
        { "wait-ms": 100 },
        { "generate-event-list": { "event-list-index": 0, "repeat": 64}},
        { "set-timestamp": { "advance-by-ms": 200}},
        { "frame-loop" : {
                "start": { "const": 0 },
                "end": { "const": 10 },
                "schedule" : [
                    { "set-timestamp": { "advance-by-ms": 20}},
                    { "send-aggregated-frame-event-list" : {
                            "source-options": { "source": "select-from-cache", "replace-random": {} },
                            "channel-indices" : { "min": 0, "max": 63 }
                    }},
                    { "wait-ms": 1 }
                ]
            }
        },
        { "wait-ms": 100 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-run-stop": { "name": { "text": "MUSR00000035" } } },
        
        { "send-run-start" : { "name": { "text": "MUSR00000035" }, "filename": { "text": "MUSR00000035" }, "instrument": { "text": "MUSR" }}},
        { "wait-ms": 100 },
        { "set-timestamp": { "advance-by-ms": 200}},
        { "frame-loop" : {
                "start": { "const": 0 },
                "end": { "const": 10 },
                "schedule" : [
                    { "set-timestamp": { "advance-by-ms": 20}},
                    { "send-aggregated-frame-event-list" : {
                            "source-options": { "source": "select-from-cache", "replace-random": {} },
                            "channel-indices" : { "min": 0, "max": 63 }
                    }},
                    { "wait-ms": 1 }
                ]
            }
        },
        { "wait-ms": 100 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-run-stop": { "name": { "text": "MUSR00000035" } } },

        { "wait-ms": 100 }
    ]
}