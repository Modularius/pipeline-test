{
    "voltage-transformation": {"scale": 1, "translate": 0 },
    "time-bins": {"from-env-var": "TIME_BINS" },
    "sample-rate": {"const": 1000000000 },
    "digitiser-config": {
        "auto-digitisers": {
            "num-digitisers": { "from-env-var" : "NUM_DIGITISERS" },
            "num-channels-per-digitiser": { "const" : 8 }
        }
    },
    "pulses": [
        {
            "pulse-type": "flat",
            "start":  { "random-type": "exponential", "lifetime": { "from-env-var": "PULSE_MEAN_LIFETIME" } },
            "width":  { "random-type": "uniform-float", "min": { "const": 20 }, "max": { "const": 50 } },
            "height": { "random-type": "uniform-float", "min": { "const": 2000 }, "max": { "const": 4000 } }
        },
        {
            "pulse-type": "triangular",
            "start":     { "random-type": "exponential", "lifetime": { "from-env-var": "PULSE_MEAN_LIFETIME" } },
            "width":     { "random-type": "uniform-float", "min": { "const": 20 }, "max": { "const": 50 } },
            "peak_time": { "random-type": "uniform-float", "min": { "const": 0.25 }, "max": { "const": 0.75 } },
            "height":    { "random-type": "uniform-float", "min": { "const": 2000 }, "max": { "const": 4000 } }
        }],
    "event-lists": [
        {
            "pulses": [ {"weight": 1, "pulse-index": 1}, {"weight": 1, "pulse-index": 0} ],
            "noises": [],
            "num-pulses": { "random-type": "constant-int", "value": { "from-env-var": "NUM_PULSES" }}
        }
    ],
    "schedule" : [
        { "set-timestamp": "now"},
        { "ensure-delay-ms": 0 },
        { "send-run-start" : { "name": { "text-env": "RUN_NAME_1" }, "filename": { "text-env": "RUN_NAME_1" }, "instrument": { "text": "Simulator" }}},
        { "wait-ms": 100 },
        { "generate-trace": { "event-list-index": 0, "repeat": 20}},
        { "set-timestamp": { "advance-by-ms": 200}},
        { "send-sample-env-log" : {
            "name" : { "text" : "PrePrefix:Prefix:Test" },
            "values-type" : "uint64",
            "location": "unknown",
            "time-delta": 1.0,
            "values" : ["39", "37", "36"]
        } },
        { "frame-loop" : {
                "start": { "const": 0 },
                "end": { "from-env-var": "LAST_FRAME" },
                "schedule" : [
                    { "set-timestamp": { "advance-by-ms": 20}},
                    {
                        "digitiser-loop" : {
                            "start": { "const": 0 },
                            "end": { "from-env-var" : "LAST_DIGITISER" },
                            "schedule" : [
                                { "send-digitiser-trace": "replace-random" },
                                { "wait-ms": 1 }
                            ]
                        }
                    }
                ]
            }
        },
        { "send-sample-env-log" : {
            "name" : { "text" : "PrePrefix:Prefix:Test" },
            "values-type" : "uint64",
            "location": "unknown",
            "time-delta": 1.0,
            "values" : ["139", "337", "236"]
        } },
        { "wait-ms": 100 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-run-stop": { "name": { "text-env": "RUN_NAME_1" } } },
        { "wait-ms": 100 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-sample-env-log" : {
            "name" : { "text" : "PrePrefix:Prefix:NewTest" },
            "values-type" : "uint64",
            "location": "unknown",
            "time-delta": 1.0,
            "values" : ["79", "47", "56"]
        } },
        { "wait-ms": 100 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-sample-env-log" : {
            "name" : { "text" : "PrePrefix:Test" },
            "values-type" : "uint64",
            "location": "unknown",
            "time-delta": 1.0,
            "values" : ["79", "47", "56"]
        } },
        { "wait-ms": 100 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-run-start" : { "name": { "text-env": "RUN_NAME_2" }, "filename": { "text-env": "RUN_NAME_2" }, "instrument": { "text": "Simulator" }}},
        { "wait-ms": 100 },
        { "set-timestamp": { "advance-by-ms": 200}},
        { "frame-loop" : {
                "start": { "const": 0 },
                "end": { "from-env-var": "LAST_FRAME" },
                "schedule" : [
                    { "set-timestamp": { "advance-by-ms": 20}},
                    {
                        "digitiser-loop" : {
                            "start": { "const": 0 },
                            "end": { "from-env-var" : "LAST_DIGITISER" },
                            "schedule" : [
                                { "send-digitiser-trace": "replace-random" },
                                { "wait-ms": 1 }
                            ]
                        }
                    }
                ]
            }
        },
        { "wait-ms": 100 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-sample-env-log" : {
            "name" : { "text" : "PrePrefix:Prefix:Test" },
            "values-type" : "uint64",
            "location": "unknown",
            "time-delta": 1.0,
            "values" : ["79", "47", "56"]
        } },
        { "wait-ms": 100 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-run-stop": { "name": { "text-env": "RUN_NAME_2" } } },
        { "send-sample-env-log" : {
            "name" : { "text" : "PrePrefix:Prefix:Test" },
            "values-type" : "uint64",
            "location": "unknown",
            "time-delta": 1.0,
            "values" : ["79", "47", "56"]
        } },
        { "wait-ms": 100 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-sample-env-log" : {
            "name" : { "text" : "PrePrefix:Prefix:Should_Not_Appear" },
            "values-type" : "uint64",
            "location": "unknown",
            "time-delta": 1.0,
            "values" : ["79", "47", "56"]
        } },
        { "wait-ms": 100 }
    ]
}