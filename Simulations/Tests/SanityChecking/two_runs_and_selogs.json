{
    "voltage-transformation": {"scale": 1, "translate": 0 },
    "time-bins": 20000,
    "sample-rate": 1000000000,
    "digitiser-config": {
        "auto-digitisers": {
            "num-digitisers": { "int" : 8 },
            "num-channels-per-digitiser": { "int" : 8 }
        }
    },
    "pulses": [
                {
                    "pulse-type": "flat",
                    "start":  { "random-type": "exponential", "lifetime": { "float": 2200 } },
                    "width":  { "random-type": "uniform", "min": { "float": 20 }, "max": { "float": 50 } },
                    "height": { "random-type": "uniform", "min": { "float": 2000 }, "max": { "float": 4000 } }
                },
                {
                    "pulse-type": "triangular",
                    "start":     { "random-type": "exponential", "lifetime": { "float": 2200 } },
                    "width":     { "random-type": "uniform", "min": { "float": 20 }, "max": { "float": 50 } },
                    "peak_time": { "random-type": "uniform", "min": { "float": 0.25 }, "max": { "float": 0.75 } },
                    "height":    { "random-type": "uniform", "min": { "float": 2000 }, "max": { "float": 4000 } }
                }],
    "event-lists": [
        {
            "pulses": [ {"weight": 1, "pulse-index": 0} ],
            "noises": [],
            "num-pulses": { "random-type": "constant", "value": { "int": 10 }}
        },
        {
            "pulses": [ {"weight": 1, "pulse-index": 1} ],
            "noises": [],
            "num-pulses": { "random-type": "constant", "value": { "int": 10 }}
        }
    ],
    "schedule" : [
        { "set-timestamp": "now"},
        { "ensure-delay-ms": 0 },
        { "send-run-start" : { "name": { "text": "SELogTest_Run1" }, "filename": { "text": "SELogTest_Run1" }, "instrument": { "text": "MuSR" }}},
        { "wait-ms": 100 },
        { "generate-trace": { "event-list-index": 1, "repeat": 20}},
        { "set-timestamp": { "advance-by-ms": 200}},
        { "send-sample-env-log" : {
            "name" : { "text" : "PrePrefix:Prefix:Test" },
            "values-type" : "uint64",
            "location": "unknown",
            "time-delta": 1.0,
            "values" : ["39", "37", "36"]
        } },
        { "frame-loop" : {
                "start": { "int": 0 },
                "end": { "int": 9 },
                "schedule" : [
                    { "set-timestamp": { "advance-by-ms": 20}},
                    {
                        "digitiser-loop" : {
                            "start": { "int": 0 },
                            "end": { "int" : 7 },
                            "schedule" : [
                                { "send-digitiser-trace": "replace-random" },
                                { "wait-ms": 1 }
                            ]
                        }
                    }
                ]
            }
        },
        { "send-sample-env-log" : {
            "name" : { "text" : "PrePrefix:Prefix:Test" },
            "values-type" : "uint64",
            "location": "unknown",
