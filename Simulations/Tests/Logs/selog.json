{
    "voltage-transformation": {"scale": 1, "translate": 0 },
    "time-bins": 20000,
    "sample-rate": 1000000000,
    "digitiser-config": {
        "auto-digitisers": {
            "num-digitisers": { "int-env" : "NUM_DIGITISERS" },
            "num-channels-per-digitiser": { "int" : 8 }
        }
    },
    "pulses": [],
    "event-lists": [],
    "schedule" : [
        { "set-timestamp": "now"},
        { "ensure-delay-ms": 0 },
        { "send-run-start" : { "name": { "text-env": "RUN_NAME" }, "instrument": { "text": "MuSR" }}},
        { "set-timestamp": { "advance-by-ms": 100}},
        { "wait-ms": 100 },
        { "send-sample-env-log" : {
            "name" : { "text" : "PrePrefix:Prefix:Earth_Core" },
            "values-type" : "uint64",
            "location": "unknown",
            "time-delta": 1.0,
            "values" : ["36", "36", "36"]
        } },
        { "send-sample-env-log" : {
            "name" : { "text" : "PrePrefix:Prefix:Earth_Other_Core" },
            "values-type" : "uint64",
            "location": "unknown",
            "time-delta": 1.0,
            "values" : ["39", "36", "36"]
        } },
        { "wait-ms": 100 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-run-stop": { "name": { "text-env": "RUN_NAME" } } },
        { "wait-ms": 100 }
    ]
}