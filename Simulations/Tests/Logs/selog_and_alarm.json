{
    "voltage-transformation": {"scale": 1, "translate": 0 },
    "time-bins": { "const ": 20000 },
    "sample-rate": { "const ": 1000000000 },
    "digitiser-config": {
        "auto-digitisers": {
            "num-digitisers": { "from-env-var" : "NUM_DIGITISERS" },
            "num-channels-per-digitiser": { "const" : 8 }
        }
    },
    "pulses": [],
    "event-lists": [],
    "schedule" : [
        { "set-timestamp": "now"},
        { "ensure-delay-ms": 0 },
        { "send-run-start" : { "name": { "text-env": "RUN_NAME" }, "filename": { "text-env": "RUN_NAME" }, "instrument": { "text": "Simulator" }}},
        { "set-timestamp": { "advance-by-ms": 100}},
        { "wait-ms": 100 },
        { "send-sample-env-log" : {
            "name" : { "text" : "PrePrefix:Prefix:Earth_Core" },
            "values-type" : "float64",
            "location": "unknown",
            "time-delta": 1.0,
            "values" : ["36.0", "36.1", "36.8"]
        } },
        { "send-sample-env-log" : {
            "name" : { "text" : "PrePrefix:Prefix:Earth_Other_Core" },
            "values-type" : "float64",
            "location": "unknown",
            "time-delta": 1.0,
            "values" : ["36.9", "36.1", "36.8"]
        } },
        { "send-alarm" : {
            "source-name" : { "text" : "PrePrefix:Prefix:Earth_Core" },
            "severity" : "minor",
            "message": "fml"
        } },
        { "set-timestamp": { "advance-by-ms": 20}},
        { "send-alarm" : {
            "source-name" : { "text" : "PrePrefix:Prefix:Earth_Core" },
            "severity" : "major",
            "message": "wtf"
        } },
        { "set-timestamp": { "advance-by-ms": 20}},
        { "send-alarm" : {
            "source-name" : { "text" : "PrePrefix:Prefix:Earth_Core" },
            "severity" : "ok",
            "message": "fml"
        } },
        { "send-sample-env-log" : {
            "name" : { "text" : "PrePrefix:Prefix:Earth_Core" },
            "values-type" : "float64",
            "location": "unknown",
            "time-delta": 1.0,
            "values" : ["33.2", "31.6", "32.4"]
        } },
        { "wait-ms": 100 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-run-stop": { "name": { "text-env": "RUN_NAME" } } }
    ]
}