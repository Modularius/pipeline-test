{
    "voltage-transformation": {"scale": 1, "translate": 0 },
    "time-bins": { "const ": 20000 },
    "sample-rate": { "const ": 1000000000 },
    "digitiser-config": {
        "auto-digitisers": {
            "num-digitisers": { "from-env-var" : "NUM_DIGITISERS" },
            "num-channels-per-digitiser": { "const" : 8 }
        }
    },
    "pulses": [],
    "event-lists": [],
    "schedule" : [
        { "set-timestamp": "now"},
        { "ensure-delay-ms": 0 },
        { "send-run-start" : { "name": { "text-env": "RUN_NAME" }, "filename": { "text-env": "RUN_NAME" }, "instrument": { "text": "Simulator" }}},
        { "set-timestamp": { "advance-by-ms": 100}},
        { "wait-ms": 100 },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:A-Double-Value" },
            "value-type" : "float64",
            "value" : ["0"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:A-Float-Value" },
            "value-type" : "float32",
            "value" : ["-58"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:A-Byte-Value" },
            "value-type" : "int8",
            "value" : ["-54"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:A-UByte-Value" },
            "value-type" : "uint8",
            "value" : ["52"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:A-Short-Value" },
            "value-type" : "int16",
            "value" : ["-540"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:A-UShort-Value" },
            "value-type" : "uint16",
            "value" : ["524"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:A-Int-Value" },
            "value-type" : "int32",
            "value" : ["-2234540"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:A-UInt-Value" },
            "value-type" : "uint32",
            "value" : ["53524"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:A-Long-Value" },
            "value-type" : "int64",
            "value" : ["-42111111111345400"]
        } },
        { "wait-ms": 100 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:A-Long-Value" },
            "value-type" : "int64",
            "value" : ["-22111111111345400"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:A-ULong-Value" },
            "value-type" : "uint64",
            "value" : ["53524000000000"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:Double-Values" },
            "value-type" : "array-float64",
            "value" : ["0.0"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:Float-Values" },
            "value-type" : "array-float32",
            "value" : ["-58.0"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:Byte-Values" },
            "value-type" : "array-int8",
            "value" : ["-54"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:UByte-Values" },
            "value-type" : "array-uint8",
            "value" : ["52"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:Short-Values" },
            "value-type" : "array-int16",
            "value" : ["-540"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:UShort-Values" },
            "value-type" : "array-uint16",
            "value" : ["524"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:Int-Values" },
            "value-type" : "array-int32",
            "value" : ["-2234540", "-2234541"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:UInt-Values" },
            "value-type" : "array-uint32",
            "value" : ["53524", "53525"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:Long-Values" },
            "value-type" : "array-int64",
            "value" : ["-42111111111345400", "-42111111111345401"]
        } },
        { "wait-ms": 100 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:A-Long-Value" },
            "value-type" : "int64",
            "value" : ["-22111111111345400"]
        } },
        { "send-run-log-data" : {
            "source-name" : { "text" : "PrePrefix:Prefix:A-ULong-Value" },
            "value-type" : "uint64",
            "value" : ["53524000000000"]
        } },
        { "wait-ms": 100 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-run-stop": { "name": { "text-env": "RUN_NAME" } } },
        { "wait-ms": 100 }
    ]
}