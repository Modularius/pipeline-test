{
    "voltage-transformation": {"scale": 1, "translate": 0 },
    "time-bins": { "from-env-var": "TIME_BINS" },
    "sample-rate": { "const": 1000000000 },
    "digitiser-config": {
        "auto-digitisers": {
            "num-digitisers": { "from-env-var" : "NUM_DIGITISERS" },
            "num-channels-per-digitiser": { "const" : 8 }
        }
    },
    "pulses": [
        {
            "pulse-type": "gaussian",
            "peak_time":     { "random-type": "uniform-float", "min": { "const": 1 }, "max": { "const": 20000 } },
            "sd":        { "random-type": "uniform-float", "min": { "const": 3 }, "max": { "const": 10 } },
            "height":    { "random-type": "uniform-float", "min": { "const": 1000 }, "max": { "const": 4000 } }
        },
        {
            "pulse-type": "back-to-back-exp",
            "spread":      { "random-type": "constant-float", "value": { "const": 3.5 } },
            "rising":        { "random-type": "constant-float", "value": { "const": 2.5 } },
            "falling":       { "random-type": "constant-float", "value": { "const": 2.4 } },
            "peak_time":   { "random-type": "uniform-float", "min": { "const": 0 }, "max": { "from-env-var": "TIME_BINS" } },
            "peak_height": { "random-type": "uniform-float", "min": { "const": 1000 }, "max": { "const": 1100 } }
        },
        {
            "pulse-type": "triangular",
            "start":     { "random-type": "uniform-float", "min": { "const": 1 }, "max": { "from-env-var": "TIME_BINS" } },
            "width":     { "random-type": "uniform-float", "min": { "const": 10 }, "max": { "const": 15 } },
            "peak_time": { "random-type": "uniform-float", "min": { "const": 0.25 }, "max": { "const": 0.75 } },
            "height":    { "random-type": "uniform-float", "min": { "const": 1000 }, "max": { "const": 4000 } }
        }
    ],
    "event-lists": [
        {
            "pulses": [ {"weight": 1, "pulse-index": 1} ],
            "noises": [],
            "num-pulses": { "random-type": "uniform-int", "min": { "const": 3 }, "max": { "const": 5 }}
        },
        {
            "pulses": [ {"weight": 1, "pulse-index": 0} ],
            "noises": [
                {
                    "bounds": {
                        "min": { "const": 0 },
                        "max": { "from-env-var": "TIME_BINS" }
                    },
                    "attributes": { "noise-type": "uniform",
                        "min": { "const": 0 },
                        "max": { "from-env-var": "MAX_NOISE" }
                    },
                    "smoothing-window-length": { "const": 10 }
                },
                {
                    "bounds": {
                        "min": { "const": 0 },
                        "max": { "from-env-var": "TIME_BINS" }
                    },
                    "attributes": { "noise-type": "gaussian",
                        "mean": { "const": 0 },
                        "sd": { "const": 5 }
                    },
                    "smoothing-window-length": { "const": 10 }
                }
            ],
            "num-pulses": { "random-type": "uniform-int", "min": { "const": 1 }, "max": { "const": 25 }}
        }
    ],
    "schedule" : [
        { "set-timestamp": "now"},
        { "ensure-delay-ms": 0 },
        { "send-run-start" : { "name": { "text-env": "RUN_NAME" }, "filename": { "text-env": "RUN_NAME" }, "instrument": { "text": "Simulator" }}},
        { "wait-ms": 1000 },
        { "set-timestamp": { "advance-by-ms": 20 } },
        { "frame-loop" : {
                "start": { "const": 0 },
                "end": { "from-env-var": "LAST_FRAME" },
                "schedule" : [
                    { "set-timestamp": { "advance-by-ms": 20}},
                    {
                        "digitiser-loop" : {
                            "start": { "const": 0 },
                            "end": { "from-env-var" : "LAST_DIGITISER" },
                            "schedule" : [
                                { "generate-trace": { "event-list-index": 1, "repeat": 1}},
                                { "send-digitiser-trace": "replace-random" },
                                { "wait-ms": 1 }
                            ]
                        }
                    }
                ]
            }
        },
        { "wait-ms": 500 },
        { "set-timestamp": { "advance-by-ms": 100}},
        { "send-run-stop": { "name": { "text-env": "RUN_NAME" } } }
    ]
}