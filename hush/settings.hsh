#### Execution

let prefix = "../digital-muon-pipeline/target/release/"
#var prefix = "../digital-muon-pipeline/target/debug/"
#var prefix = "cargo run --manifest-path "../supermusr-data-pipeline" --release --bin "

let execution_paths = @[
    simulator: prefix++"simulator",
    trace_reader: prefix++"trace-reader",
    nexus_writer: prefix++"nexus-writer",
    digitiser_aggregator: prefix++"digitiser-aggregator",
    trace_to_events: prefix++"trace-to-events"
]

let process_names = @[
    nexus_writer: "nexus-writer",
    digitiser_aggregator:"digitiser-aggre",
    trace_to_events: "trace-to-events",
    simulator: "simulator"
]

let container_images = @[
    nexus_writer: @[
        image: "supermusr-nexus-writer:latest",
        env_vars: @[
            image: "IMAGE_WRITER",
            obsv_port: "OBSV_ADDRESS_WRITER",
            args: "WRITER_ARGS"
        ]
    ],
    digitiser_aggregator: @[
        image: "supermusr-digitiser-aggregator:latest",
        env_vars: @[
            image: "IMAGE_AGGREGATOR",
            obsv_port: "OBSV_ADDRESS_AGGREGATOR",
            args: "AGGREGATOR_ARGS"
        ]
    ],
    trace_to_events: @[
        image: "supermusr-trace-to-events:latest",
        env_vars: @[
            image: "IMAGE_EVENT_FORMATION",
            obsv_port: "OBSV_ADDRESS_EVENT_FORMATION",
            args: "EVENT_FORMATION_ARGS"
        ]
    ],
    simulator: @[
        image: "supermusr-simulator:latest",
        env_vars: @[
            image: "IMAGE_SIMULATOR",
            observability_port: "OBSV_ADDRESS_SIMULATOR",
            args: "SIMULATOR_ARGS"
        ]
    ]
]

#### Observability

let observability = @[
    OTEL_ENDPOINT: "http://172.16.105.83:4317/v1/traces",          # OTel VM
    trace_to_events: "127.0.0.1:29090",       # Local
    digitiser_aggregator: "127.0.0.1:29091",       # Local
    nexus_writer: "127.0.0.1:29092",       # Local
    simulator: "127.0.0.1:29093"       # Local
]
#g_OTEL_ENDPOINT="http://${g_LOCALHOST}:4317/v1/traces"
#g_OTEL_ENDPOINT="http://172.16.113.245:4317/v1/traces"       # HiFi
#g_OTEL_ENDPOINT="http://146.199.207.182:4317/v1/traces"      # MyPC
#g_OTEL_ENDPOINT=""


let RUST_LOG_OFF = "tonic=off,h2=off,tokio_util=off,tower=off,hyper=off"
let env_vars = @[
    ## Tell the logger not to use ansi colours (comment out to enable them)
    NO_COLOR: true,
    ## Stdout Observability Levels
    RUST_LOG: "info,digitiser_aggregator=warn,nexus_writer=warn,trace_to_events=warn,"++RUST_LOG_OFF,
    ## Otel Observability Levels
    OTEL_LEVEL: "info,simulator=off,digitiser_aggregator=info,nexus_writer=info,trace_to_events=info,trace_to_events::channels=info,trace_to_events::pulse_detection=warn"
]

#### Event Formation
let event_formation_commands = @[
    settings1: @[
        mode: "differential-threshold-discriminator",
        begin_threshold: "--begin-threshold=5",
        end_threshold: "--end-threshold=0",
        begin_duration: "--begin-duration=2",
        end_duration: "--end-duration=0",
        cooloff: "--cool-off=0",
        peak_mode: "--peak-height-mode=value-at-end-trigger",
        peak_basis: "--peak-height-basis=trace-baseline",
        build: function()
            return [self.mode,
                self.begin_threshold,
                self.end_threshold,
                self.begin_duration,
                self.end_duration,
                self.cooloff,
                self.peak_mode,
                self.peak_basis
            ]
        end
    ]
]

#g_TTE_INPUT_COMMAND="${g_TTE_INPUT_MODE} ${g_TTE_THRESHOLD} ${g_TTE_DURATION} ${g_TTE_COOLOFF} ${g_TTE_PEAK_MODE} ${g_TTE_PEAK_BASIS}"

#### Brokers
let broker_settings = @[
    local: @[
        pipeline_name: "local",
        # Use This Broker
        address: "localhost:19092",
        # Broker Topics
        topics: @[
            TRACE: "Traces",
            DAT_EVENT: "Events",
            FRAME_EVENT: "FrameEvents",
            CONTROL: "Controls",
            LOGS: "Logs",
            SELOGS: "SELogs",
            ALARMS: "Alarms"
        ],
        consumer_groups: @[
            nexus_writer:"nexus-writer",
            digitiser_aggregator:"digitiser-aggregator",
            trace_to_events:"trace-to-events"
        ],
        # Trace Source Dependent Event Formation Settings
        event_formation: @[
            POLARITY: "positive",
            BASELINE: "0"
        ],
        # Digitisers Expected from Broker
        DIGITISERS: "-d0,1,2,3,4,5,6,7",
        FRAME_TTL_MS: "3500",
        SEND_FRAME_BUFFER_SIZE: "4000",
        # Output Path
        paths: @[
            NEXUS_OUTPUT: "Output/local",
            NEXUS_ARCHIVE: "archive/incoming/local"
        ],
        RUN_TTL_MS: 9000
    ]
]

let build_simulator_arguments = function(super, source)
    return ["--broker", super.broker.address,
    "--otel-endpoint", super.constants.observability.OTEL_ENDPOINT,
    "--otel-namespace", super.broker.pipeline_name,
    "defined", source,
    "--digitiser-trace-topic", super.broker.topics.TRACE,
    "--digitiser-event-topic", super.broker.topics.DAT_EVENT,
    "--frame-event-topic", super.broker.topics.FRAME_EVENT,
    "--control-topic", super.broker.topics.CONTROL,
    "--runlog-topic", super.broker.topics.LOGS,
    "--selog-topic", super.broker.topics.SELOGS,
    "--alarm-topic", super.broker.topics.ALARMS]
end

let build_arguments = function(super, component)
    if component == "trace_to_events" then
        let args = ["--broker", super.broker.address,
            "--consumer-group", super.broker.consumer_groups.trace_to_events,
            "--observability-address", super.constants.observability.trace_to_events,
            "--trace-topic", super.broker.topics.TRACE,
            "--event-topic", super.broker.topics.DAT_EVENT,
            "--polarity", super.broker.event_formation.POLARITY,
            "--baseline", super.broker.event_formation.BASELINE,
            "--otel-endpoint", super.constants.observability.OTEL_ENDPOINT,
            "--otel-namespace", super.broker.pipeline_name
        ]
        let ef_args = super.event_formation_command.build()
        for cmd in std.iter(ef_args) do
            std.push(args,cmd)
        end
        return args
    end if component == "digitiser_aggregator" then
        return ["--broker", super.broker.address,
            "--group", super.broker.consumer_groups.digitiser_aggregator,
            "--observability-address", super.constants.observability.digitiser_aggregator,
            "--input-topic", super.broker.topics.DAT_EVENT,
            "--output-topic", super.broker.topics.FRAME_EVENT,
            "--frame-ttl-ms", super.broker.FRAME_TTL_MS,
            "--send-frame-buffer-size", super.broker.SEND_FRAME_BUFFER_SIZE,
            "--otel-endpoint", super.constants.observability.OTEL_ENDPOINT,
            "--otel-namespace", super.broker.pipeline_name,
            super.broker.DIGITISERS
        ]
    end if component == "nexus_writer" then
        return ["--broker", super.broker.address,
            "--consumer-group", super.broker.consumer_groups.nexus_writer,
            "--observability-address", super.constants.observability.nexus_writer,
            "--control-topic", super.broker.topics.CONTROL,
            "--frame-event-topic", super.broker.topics.FRAME_EVENT,
            "--log-topic", super.broker.topics.LOGS,
            "--sample-env-topic", super.broker.topics.SELOGS,
            "--alarm-topic", super.broker.topics.ALARMS,
            "--cache-run-ttl-ms", std.to_string(super.broker.RUN_TTL_MS),
            "--otel-endpoint", super.constants.observability.OTEL_ENDPOINT,
            "--otel-namespace", super.broker.pipeline_name,
            "--local-path", super.broker.paths.NEXUS_OUTPUT,
            "--archive-path", super.broker.paths.NEXUS_ARCHIVE
        ]
    end
end

let constants = @[
    execution_paths: execution_paths,
    process_names: process_names,
    container_images: container_images,
    observability: observability,
    env_vars: env_vars,
]

@[
    constants: constants,
    dependents: function (broker, ef_command)
        return @[
            constants: constants,
            event_formation_command: event_formation_commands[ef_command],
            broker: broker_settings[broker],
            build_arguments: function(component) build_arguments(self, component) end,
            build_simulator_arguments: function(source) build_simulator_arguments(self, source) end
        ]
    end
]