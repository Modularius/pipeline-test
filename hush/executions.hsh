let Settings = std.import("settings.hsh")("localhost", 7, "settings1", "local")

function event_formation_commands(settings)
    return "--broker " ++ settings.broker.address ++ $g_BROKER --consumer-group $g_GROUP_EVENT_FORMATION \
    --observability-address $g_OBSV_ADDRESS_EVENT_FORMATION \
    --trace-topic $g_TRACE_TOPIC \
    --event-topic $g_DAT_EVENT_TOPIC \
    --polarity $g_TTE_POLARITY \
    --baseline $g_TTE_BASELINE \
    --otel-endpoint $g_OTEL_ENDPOINT \
    --otel-namespace=$g_PIPELINE_NAME \
    $g_TTE_INPUT_COMMAND"
end

function()
    return @[
        benchmark: @[
            execute: function(local_broker, host_mode)
                
            end
        ]
    ]
end